{
  "schema_version": 1,
  "notes": "Every FFmpeg and FFprobe command used by recording, archive, time-lapse, playback preparation, snapshots, CAM3 publishing and media verification is represented here. Argument arrays are executed directly (never through a shell). Placeholders are substituted individually. Advanced edits are powerful: validate against a test clip before using them on recordings.\nNative desktop viewing uses mpv on the host; it does not use FFmpeg frame extraction. Optional external RTSP audio sources are muxed onto a camera path by audio_mux_publish. This does not re-encode video.\nThe CAM3 publish command maps audio when the incoming FLV stream contains it; the preserved RTMP bridge currently reconstructs video packets only. A separate RTSP audio-only source can also be configured per camera and muxed onto its MediaMTX path.\nThe camera_snapshot command is exclusively a one-off still image for detection-zone calibration. No live preview or playback path uses still-frame extraction or image2pipe.\nTime-lapse outputs retain audio where the source has an audio track. Fixed-speed regular time-lapse time-stretches audio at the same tempo; intelligent time-lapse uses its duration-weighted effective speed so total audio/video durations match (local timing is an approximation across adaptive speed transitions). CAM3 has no microphone and therefore no source audio to preserve.\nCue Export Studio: export_probe checks each source file; export_segment normalizes and time-aligns each camera segment; export_concat joins normalized segments/sections; export_layout creates one/two/three-camera split-screen sections. These templates are editable here, and no source recording is changed.",
  "timelapse_regular": [
    "{ffmpeg}",
    "-hide_banner",
    "-nostdin",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-f",
    "concat",
    "-safe",
    "0",
    "-i",
    "{concat_list}",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-vf",
    "fps=1/{sample_seconds},setpts=PTS/{speed}",
    "-af",
    "{audio_filter}",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-c:v",
    "{video_codec}",
    "-crf",
    "{crf}",
    "-preset",
    "{preset}",
    "-r",
    "{output_fps}",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "archive_clip": [
    "{ffmpeg}",
    "-hide_banner",
    "-nostdin",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-i",
    "{input}",
    "-ss",
    "{seek}",
    "-t",
    "{duration}",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-c:v",
    "{video_codec}",
    "-crf",
    "{crf}",
    "-preset",
    "{preset}",
    "-pix_fmt",
    "{pixel_format}",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "archive_join": [
    "{ffmpeg}",
    "-hide_banner",
    "-nostdin",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-f",
    "concat",
    "-safe",
    "0",
    "-i",
    "{concat_list}",
    "-map",
    "0",
    "-c",
    "copy",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "timelapse_intelligent": [
    "{ffmpeg}",
    "-hide_banner",
    "-nostdin",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-f",
    "concat",
    "-safe",
    "0",
    "-i",
    "{concat_list}",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-vf",
    "{select_filter}",
    "-af",
    "{audio_filter}",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-c:v",
    "{video_codec}",
    "-crf",
    "{crf}",
    "-preset",
    "{preset}",
    "-fps_mode",
    "cfr",
    "-r",
    "{output_fps}",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "archive_probe_duration": [
    "{ffprobe}",
    "-v",
    "error",
    "-show_entries",
    "format=duration",
    "-of",
    "default=nw=1:nk=1",
    "{input}"
  ],
  "archive_verify_probe": [
    "{ffprobe}",
    "-v",
    "error",
    "-show_entries",
    "format=duration,size",
    "-of",
    "json",
    "{input}"
  ],
  "archive_verify_decode": [
    "{ffmpeg}",
    "-nostdin",
    "-hide_banner",
    "-loglevel",
    "error",
    "-i",
    "{input}",
    "-map",
    "0:v:0",
    "-frames:v",
    "{frames}",
    "-f",
    "null",
    "-"
  ],
  "timelapse_motion_scan": [
    "{ffmpeg}",
    "-nostdin",
    "-hide_banner",
    "-loglevel",
    "{loglevel}",
    "-f",
    "concat",
    "-safe",
    "0",
    "-i",
    "{concat_list}",
    "-vf",
    "fps={fps},scale={width}:{height},format=gray",
    "-f",
    "rawvideo",
    "pipe:1"
  ],
  "timelapse_source_probe": [
    "{ffprobe}",
    "-v",
    "error",
    "-select_streams",
    "v:0",
    "-show_entries",
    "stream=avg_frame_rate",
    "-of",
    "default=nw=1:nk=1",
    "{input}"
  ],
  "playback_codec_probe": [
    "{ffprobe}",
    "-v",
    "error",
    "-select_streams",
    "v:0",
    "-show_entries",
    "stream=codec_name",
    "-of",
    "default=nw=1:nk=1",
    "{input}"
  ],
  "playback_prepare_copy": [
    "{ffmpeg}",
    "-nostdin",
    "-hide_banner",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-i",
    "{input}",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-c:v",
    "copy",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "playback_prepare_transcode": [
    "{ffmpeg}",
    "-nostdin",
    "-hide_banner",
    "-y",
    "-loglevel",
    "{loglevel}",
    "-i",
    "{input}",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-c:v",
    "{video_codec}",
    "-preset",
    "{preset}",
    "-crf",
    "{crf}",
    "-pix_fmt",
    "{pixel_format}",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-movflags",
    "+faststart",
    "{output}"
  ],
  "camera_snapshot": [
    "{ffmpeg}",
    "-nostdin",
    "-hide_banner",
    "-loglevel",
    "{loglevel}",
    "-rtsp_transport",
    "{transport}",
    "-i",
    "{input}",
    "-frames:v",
    "1",
    "-vf",
    "scale=640:-2",
    "-f",
    "image2pipe",
    "-vcodec",
    "png",
    "pipe:1"
  ],
  "camera_test_probe": [
    "{ffprobe}",
    "-v",
    "error",
    "-rtsp_transport",
    "{transport}",
    "-i",
    "{input}",
    "-select_streams",
    "v:0",
    "-show_streams",
    "-show_entries",
    "stream=codec_name,width,height,r_frame_rate",
    "-of",
    "json"
  ],
  "cam3_publish": [
    "{ffmpeg}",
    "-hide_banner",
    "-loglevel",
    "{loglevel}",
    "-f",
    "flv",
    "-i",
    "pipe:0",
    "-map",
    "0:v:0",
    "-map",
    "0:a?",
    "-c:v",
    "copy",
    "-c:a",
    "copy",
    "-muxdelay",
    "0.1",
    "-f",
    "rtsp",
    "-rtsp_transport",
    "tcp",
    "{rtsp_url}"
  ],
  "ffmpeg_version": [
    "{ffmpeg}",
    "-version"
  ],
  "audio_mux_publish": [
    "{ffmpeg}",
    "-hide_banner",
    "-nostdin",
    "-loglevel",
    "{loglevel}",
    "-rtsp_transport",
    "tcp",
    "-i",
    "{video_url}",
    "-rtsp_transport",
    "tcp",
    "-i",
    "{audio_url}",
    "-map",
    "0:v:0",
    "-map",
    "1:a:0",
    "-c:v",
    "copy",
    "-c:a",
    "{audio_codec}",
    "-b:a",
    "{audio_bitrate}",
    "-f",
    "rtsp",
    "-rtsp_transport",
    "tcp",
    "{output_url}"
  ],
  "export_probe": [
    "{ffprobe}",
    "-v",
    "error",
    "-show_entries",
    "format=duration:stream=codec_type",
    "-of",
    "json",
    "{input}"
  ],
  "export_segment": [
