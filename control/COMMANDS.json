    "{fps}",
    "-c:v",
    "libx264",
    "-preset",
    "{preset}",
    "-crf",
    "{crf}",
    "-pix_fmt",
    "yuv420p",
    "-c:a",
    "aac",
    "-b:a",
    "{audio_bitrate}",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-movflags",
